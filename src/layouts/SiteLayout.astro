---
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";

const {
  title,
  description = "Photography by Max Hodges — documentary and street photography from Japan and beyond.",
  ogImage,
  breadcrumbItems = [],
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = ogImage ? new URL(ogImage, Astro.site).href : undefined;
const currentPath = Astro.url.pathname;
const navItems = [
  { label: "Galleries", href: "/" },
  { label: "Projects", href: "/blog" },
];
const isActive = (href) =>
  href === "/" ? currentPath === "/" || currentPath.startsWith("/gallery") : currentPath.startsWith(href);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Max Hodges" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
    <meta name="twitter:card" content={ogImageUrl ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}
    <ClientRouter />
  </head>
  <body class="antialiased">
    <div class="min-h-screen px-4 sm:px-10 lg:px-16">
      <header class="flex items-baseline justify-between gap-4 py-5 sm:py-6">
        <div class="flex min-w-0 items-baseline gap-4 sm:gap-6">
          <a
            href="/"
            class="font-display text-xl font-medium transition hover:text-[color:var(--rust)] sm:text-2xl"
          >
            Max Hodges
          </a>
          {
            breadcrumbItems.length > 0 && (
              <nav
                aria-label="Breadcrumb"
                class="hidden min-w-0 truncate font-mono text-[0.7rem] tracking-[0.03em] text-[color:var(--muted)] sm:block"
              >
                {breadcrumbItems.map((item, i) => (
                  <>
                    {i > 0 && <span class="opacity-50">{" / "}</span>}
                    {item.href ? (
                      <a class="transition hover:text-[color:var(--rust)]" href={item.href}>
                        {item.label}
                      </a>
                    ) : (
                      <span class="text-[color:var(--ink)]/70">{item.label}</span>
                    )}
                  </>
                ))}
              </nav>
            )
          }
        </div>
        <nav class="flex shrink-0 items-baseline gap-5 font-mono text-[0.7rem] tracking-[0.03em]">
          {
            navItems.map((item) => (
              <a
                href={item.href}
                class:list={[
                  "transition hover:text-[color:var(--rust)]",
                  isActive(item.href)
                    ? "text-[color:var(--ink)]"
                    : "text-[color:var(--muted)]",
                ]}
              >
                {item.label}
              </a>
            ))
          }
        </nav>
      </header>

      <main class="pb-10">
        <slot />
      </main>

      <footer class="mt-4 flex flex-wrap items-center justify-between gap-3 border-t border-white/10 py-6 font-mono text-[0.7rem] tracking-[0.03em] text-[color:var(--muted)]">
        <div>© {new Date().getFullYear()} Max Hodges</div>
        <div class="flex gap-5">
          <a class="transition hover:text-[color:var(--rust)]" href="/">
            Galleries
          </a>
          <a class="transition hover:text-[color:var(--rust)]" href="/blog">
            Blog
          </a>
        </div>
      </footer>
    </div>
  </body>
</html>
