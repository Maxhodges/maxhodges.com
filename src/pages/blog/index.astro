---
import { Picture, getImage } from "astro:assets";
import { getCollection } from "astro:content";
import SiteLayout from "../../layouts/SiteLayout.astro";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const ogImage =
  posts.length > 0
    ? (await getImage({ src: posts[0].data.heroImage, width: 1200, format: "jpeg" })).src
    : undefined;

const formatDate = (date) =>
  new Intl.DateTimeFormat("en-US", {
    month: "short",
    day: "2-digit",
    year: "numeric",
  }).format(date);
---

<SiteLayout
  title="Max Hodges — Blog"
  description="Notes, interviews, and conversations about the image — the blog of photographer Max Hodges."
  ogImage={ogImage}
  breadcrumbItems={[{ label: "Blog" }]}
>
  <section class="grid gap-8">
    <header>
      <h1 class="font-display text-4xl font-medium leading-tight sm:text-5xl">Blog</h1>
      <p class="mt-3 max-w-xl font-mono text-[0.7rem] tracking-[0.03em] text-[color:var(--muted)]">
        Notes, interviews, and conversations about the image.
      </p>
    </header>

    <div class="grid gap-6 md:grid-cols-2">
      {
        posts.map((post, index) => (
          <a
            href={`/blog/${post.slug}`}
            class="group relative overflow-hidden rounded-2xl border border-white/10 bg-black/30 shadow-[0_20px_60px_rgba(0,0,0,0.45)] transition hover:-translate-y-1 hover:border-white/20 hover:shadow-[0_30px_70px_rgba(0,0,0,0.6)]"
          >
            <div class="aspect-[4/3] overflow-hidden">
              <Picture
                src={post.data.heroImage}
                alt={post.data.title}
                widths={[480, 960, 1440]}
                formats={["webp", "jpeg"]}
                sizes="(max-width: 768px) 92vw, 45vw"
                pictureAttributes={{ class: "h-full w-full block" }}
                class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.02]"
                loading={index === 0 ? "eager" : "lazy"}
                fetchpriority={index === 0 ? "high" : undefined}
              />
            </div>
            <div class="grid gap-3 bg-[#141210] px-6 py-5 text-[color:var(--ink)]">
              <div class="font-mono text-[0.7rem] tracking-[0.03em] text-[color:var(--muted)]">
                {formatDate(post.data.pubDate)}
              </div>
              <div class="font-display text-2xl font-medium">{post.data.title}</div>
              <p class="text-[15px] text-[color:var(--muted)]">{post.data.description}</p>
            </div>
          </a>
        ))
      }
    </div>
  </section>
</SiteLayout>
