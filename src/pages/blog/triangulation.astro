  panel.innerHTML=`
    <div class="eyebrow">Readout</div>
    <h2>${esc(a.name)}</h2>
    <div class="meta">${esc(a.who)}</div>
    <span class="zonepill" style="${pillStyle}">${esc(z.label)}</span>
    <div class="mins">${a.min.toLocaleString()}+ min in my 2026 listening<div class="bar"><i style="width:${(a.min/maxMin*100).toFixed(1)}%"></i></div></div>
    <p class="aes">${esc(a.aes)}</p>
    <h3>Signature</h3>
    <ul>${a.sig.map(s=>`<li>${esc(s)}</li>`).join("")}</ul>
    <div class="try"><div class="eyebrow" style="margin-bottom:4px">Try this</div><p>${esc(a.tryit)}</p></div>
    <h3>Threads</h3>
    <div class="tags">${inThreads.map(n=>`<span>${esc(n)}</span>`).join("")||"<span>none</span>"}</div>
    <h3>Tags</h3>
    <div class="tags">${a.tags.map(s=>`<span>${esc(s)}</span>`).join("")}</div>
    <h3>Labels &amp; scene</h3>
    <div class="src">${esc(a.labels)}</div>
