    <div class="src">${a.src.map(([n,u])=>`<a href="${u}" target="_blank" rel="noopener">${esc(n)}</a>`).join(" · ")}</div>`;
  try{localStorage.setItem("tri-sel",id)}catch(e){}
}

const chips=document.getElementById("chips"),note=document.getElementById("threadnote");
let active=null;
