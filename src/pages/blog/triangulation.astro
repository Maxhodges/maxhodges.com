function setThread(id){
  active=id;
  document.querySelectorAll(".chip").forEach(c=>c.setAttribute("aria-pressed",String(c.id==="chip-"+id)));
  const t=THREADS.find(x=>x.id===id);
  document.querySelectorAll(".node").forEach(n=>{
    const on=!t||t.ids.includes(n.dataset.id);
    n.classList.toggle("dim",!!t&&!on);n.classList.toggle("lit",!!t&&on);
