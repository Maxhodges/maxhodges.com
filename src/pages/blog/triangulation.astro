  if(t){const names=t.ids.map(i=>A.find(a=>a.id===i).name).join(", ");note.innerHTML=`<b>${esc(t.name)}.</b> ${esc(t.note)} <br><span style="font-family:var(--mono);font-size:11.5px">${esc(names)}</span>`}
  else note.textContent="Each thread cuts across the circles. Pick one to light up the artists who share it.";
}
