---
// Interactive blog article: concept page for the Shindo Versio firmware.
// Deliberately standalone (no SiteLayout/Tailwind) to keep the piece's
// own art direction; fonts are self-hosted like the rest of the site.
// The body below mirrors the project's master page (shindo-versio/site),
// with the breadcrumb, absolute audio paths and font names adapted.
import "@fontsource-variable/big-shoulders-display";
import "@fontsource/barlow/400.css";
import "@fontsource/barlow/500.css";
import "@fontsource/barlow/700.css";
import "@fontsource/noto-sans-jp/900.css";
import "@fontsource/ibm-plex-mono/500.css";
import "@fontsource/ibm-plex-mono/600.css";
import { getImage } from "astro:assets";
import heroSrc from "../../assets/images/blog/shindo.jpg";

const title = "Shindo Versio — Max Hodges";
const description =
  "Concept firmware for the Noise Engineering Versio: a bottomless rumble and texture generator for industrial techno, built on the kick itself — three reverb engines, built-in sidechain ducking, one knob per job.";
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(
  (await getImage({ src: heroSrc, width: 1200, format: "jpeg" })).src,
  Astro.site,
).href;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="article" />
    <meta property="og:site_name" content="Max Hodges" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body>
    <style is:global>
/* Layout: one product page that doubles as the manual, set like a Japanese industrial spec sheet:
   white paper, black ink, one signal red; square corners, ruled sections, numbered parts. */
:root {
  --bg: #f4f5f3;
  --panel: #ffffff;
  --ink: #141414;
  --muted: #5d6063;
  --line: #d3d5d2;
  --red: #d6000f;
  --rumble: var(--red);
  --kick: var(--ink);
  --duck: #6d7074;
  --on-red: #ffffff;
  /* The duck scope is a screen, dark in both themes, in the sandbox's colours. */
  --scope-bg: #121110; --scope-ink: #ece8e2; --scope-muted: #9a948b; --scope-line: #3a3632;
  --scope-kick: #3ef07a; --scope-rumble: #ff3ea5; --scope-texture: #ffb000;
  --scope-hold: #3b82f6; --scope-release: #a855f7;
  /* Typeface pairings, picked with the A–E selector in the maker strip (A is the default). */
  --display: "Big Shoulders Display Variable", "Arial Narrow", Impact, sans-serif;
  --dw: 700;
  --body: "Barlow", "Helvetica Neue", Arial, system-ui, sans-serif;
  --kanji: "Noto Sans JP", "Hiragino Sans", "Yu Gothic", sans-serif;
  --mono: "IBM Plex Mono", ui-monospace, Menlo, Consolas, monospace;
}
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    --bg: #111213; --panel: #191a1c; --ink: #f0f0ee; --muted: #9b9ea2; --line: #2f3134;
    --red: #ff3d33; --duck: #a9acb0; --on-red: #111213; color-scheme: dark;
  }
}
:root[data-theme="dark"] {
  --bg: #111213; --panel: #191a1c; --ink: #f0f0ee; --muted: #9b9ea2; --line: #2f3134;
  --red: #ff3d33; --duck: #a9acb0; --on-red: #111213; color-scheme: dark;
}
body {
  background: var(--bg); color: var(--ink); font-family: var(--body); font-size: 16px; line-height: 1.65;
  padding-left: max(16px, env(safe-area-inset-left, 0px));
  padding-right: max(16px, env(safe-area-inset-right, 0px));
}
main { max-width: 1040px; margin: 0 auto; padding-block: 36px 96px; display: flex; flex-direction: column; gap: 96px; }
h1, h2, h3 { text-wrap: balance; margin: 0; line-height: 1.1; }
h1 { font-family: var(--display); font-weight: var(--dw); font-size: clamp(2.6rem, 9vw, 5.2rem); letter-spacing: 0; line-height: 0.92; text-transform: uppercase; }
h2 { font-family: var(--body); font-size: 1.6rem; font-weight: 700; padding-top: 14px; border-top: 1px solid var(--ink); }
h3 { font-family: var(--body); font-size: 1.12rem; font-weight: 700; }
h4 { margin: 0; font-family: var(--mono); font-size: 0.8rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); }
p { margin: 0; max-width: 68ch; }
a { color: var(--red); }
.eyebrow { font-family: var(--mono); font-size: 0.76rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); }
section, header { display: flex; flex-direction: column; gap: 24px; }
.lede { font-size: 1.18rem; }
.lede b { color: var(--red); }
.k { color: var(--kick); font-weight: 700; }
.r { color: var(--red); font-weight: 700; }
.note { color: var(--muted); font-size: 0.93rem; }
.todo { font-family: var(--mono); font-size: 0.7rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--bg); background: var(--muted); padding: 1px 6px; white-space: nowrap; }

/* Hero */
.maker { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 4px 16px; font-family: var(--mono); font-size: 0.78rem; letter-spacing: 0.12em; text-transform: uppercase; padding-bottom: 8px; border-bottom: 1px solid var(--ink); }
.maker b { font-weight: 600; }
.maker > span { color: var(--muted); }
.title { display: grid; grid-template-columns: 1fr auto; gap: 10px 22px; align-items: end; }
.title h1 { grid-column: 1; grid-row: 1; }
.title .tagline { grid-column: 1; grid-row: 2; font-family: var(--mono); font-size: 0.95rem; letter-spacing: 0.08em; text-transform: uppercase; }
.kanji { grid-column: 2; grid-row: 1 / span 2; align-self: start; justify-self: end; width: fit-content; font-family: var(--kanji); font-weight: 900; color: var(--red); font-size: clamp(3.4rem, 13vw, 7rem); line-height: 0.9; }
/* ヴェルシオ justified to the exact width of 震度 above it (均等割付) */
.kanji small { display: block; font-size: 0.22em; margin-top: 0.9em; font-weight: 900; text-align: justify; text-align-last: justify; }
@media (max-width: 520px) { .kanji { font-size: 3rem; } }

/* Features follows straight on from the intro: no section rule. */
#features h2 { border-top: 0; padding-top: 0; }
/* Hero: text left, the module straight on at the right. */
.hero { display: grid; grid-template-columns: minmax(0, 1fr) 130px; gap: 48px; align-items: center; padding-right: 40px; }
.hero-text { display: flex; flex-direction: column; gap: 24px; min-width: 0; }
.hero-panel { margin: 0; }
.hero-svg { display: block; width: 100%; height: auto; filter: drop-shadow(0 10px 16px rgba(0, 0, 0, 0.22)); }
@media (max-width: 720px) { .hero { grid-template-columns: 1fr; } .hero-panel { display: none; } }
nav.toc { display: flex; flex-wrap: wrap; gap: 6px 18px; font-family: var(--mono); font-size: 0.85rem; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); padding-block: 10px; }
nav.toc a { color: var(--muted); text-decoration: none; }
nav.toc a:hover, nav.toc a:focus-visible { color: var(--ink); }

ul.features { margin: 0; padding: 0; list-style: none; display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 20px 28px; }
ul.features li { border-left: 1.5px solid var(--red); padding-left: 12px; min-width: 0; }
ul.features b { display: block; }
ul.features span { color: var(--muted); font-size: 0.95rem; }
ul.features ul.sub3 { margin: 2px 0 0; padding-left: 18px; color: var(--muted); font-size: 0.95rem; display: flex; flex-direction: column; gap: 2px; }
ul.features ul.sub3 li { border: 0; padding: 0; }
ul.features ul.sub3 b { display: inline; color: var(--ink); font-weight: 500; }

.box { background: var(--panel); border: 1px solid var(--line); padding: 16px; display: flex; flex-direction: column; gap: 12px; }
.scope { background: var(--scope-bg); border-color: var(--scope-line); }
.scope svg { width: 100%; height: auto; display: block; }
.scope svg text { font-family: var(--mono); font-size: 11px; fill: var(--scope-muted); }
.scope svg text.tag { font-size: 13px; fill: var(--scope-ink); stroke: var(--scope-bg); stroke-width: 4px; }
.scope .legend { color: var(--scope-muted); }
.scope .legend .lk { color: var(--scope-kick); } .scope .legend .lr { color: var(--scope-rumble); }
.scope .legend .lt { color: var(--scope-texture); } .scope .legend .ld { color: var(--scope-ink); }
.legend { display: flex; flex-wrap: wrap; gap: 6px 18px; font-size: 0.85rem; color: var(--muted); }
.legend span::before { content: ""; display: inline-block; width: 12px; height: 3px; vertical-align: middle; margin-right: 6px; background: currentColor; }
.legend .lk { color: var(--kick); } .legend .lr { color: var(--rumble); } .legend .ld { color: var(--duck); }

/* Listen */
.presets { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; }
@media (max-width: 720px) { .presets { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
.preset { background: var(--panel); border: 1px solid var(--line); padding: 14px; display: flex; flex-direction: column; gap: 10px; min-width: 0; }
.preset b { font-family: var(--body); font-weight: 700; font-size: 1.1rem; }
.preset .d { color: var(--muted); font-size: 0.9rem; }
.presets.demos { grid-template-columns: repeat(2, minmax(0, 1fr)); }
@media (max-width: 720px) { .presets.demos { grid-template-columns: 1fr; } }
.seg { display: inline-flex; border: 1px solid var(--line); overflow: hidden; align-self: flex-start; }
.seg button { font: 600 0.8rem var(--mono); color: var(--muted); background: none; border: 0; padding: 5px 10px; cursor: pointer; }
.seg button + button { border-left: 1px solid var(--line); }
.seg button:hover { color: var(--ink); }
.seg button[aria-pressed="true"] { background: var(--red); color: var(--on-red); }
.demo-controls { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
.demo .pl { font: 600 0.8rem var(--mono); letter-spacing: 0.08em; color: var(--on-red); background: var(--red); border: 0; padding: 7px 16px; cursor: pointer; }

/* Signal flow */
.flowwrap { overflow-x: auto; background: var(--panel); border: 1px solid var(--line); padding: 12px; }
.flowwrap svg { display: block; width: 100%; min-width: 760px; height: auto; }
.sf text { font-family: var(--mono); font-size: 13px; letter-spacing: 0.06em; fill: var(--ink); }
.sf .sub { font-size: 10.5px; fill: var(--muted); letter-spacing: 0.03em; }
.sf .sec { font-family: var(--display); font-weight: var(--dw); font-size: 19px; letter-spacing: 0.04em; }
.sf .arrow { fill: var(--ink); }
.sf .ink { stroke: var(--ink); }
.sf .frame { fill: none; stroke: var(--line); stroke-width: 2; }
.sf .blk { fill: var(--bg); stroke: var(--ink); stroke-width: 2; }
.sf .w { fill: none; stroke: var(--ink); stroke-width: 1.6; }
.sf .norm { fill: none; stroke: var(--ink); stroke-width: 1.6; stroke-dasharray: 2 4; }
.sf .dot { fill: var(--ink); }
.sf .tag-r { fill: var(--red); } .sf .tag-k { fill: var(--ink); }
.sf .tagt { fill: var(--bg); font-weight: 600; }
.sf .mix { fill: var(--bg); stroke: var(--ink); stroke-width: 1.6; }

/* Panel */
.panel-fig { margin: 0; display: flex; justify-content: center; }
.panel-fig svg { width: min(520px, 100%); height: auto; display: block; }
.pt { font-family: var(--mono); fill: #f3eef8; }
.pt.title { font-family: var(--display); font-size: 4.4px; letter-spacing: 0.06em; }
.pt.lbl { font-size: 1.85px; letter-spacing: 0.04em; }
.pt.tiny { font-size: 1.45px; fill: #8e8898; }
.co circle { fill: var(--red); }
.co text { font-family: var(--mono); font-weight: 600; font-size: 3.2px; fill: #ffffff; }
.co line, .co polyline { stroke: var(--red); stroke-width: 0.35; }
.co .dot { fill: var(--red); }
.num { width: 26px; height: 26px; background: var(--red); color: var(--on-red); font-family: var(--mono); font-weight: 600; font-size: 0.82rem; display: grid; place-items: center; font-variant-numeric: tabular-nums; flex: none; }

/* Controls reference */
.ref { display: flex; flex-direction: column; gap: 0; border-top: 1px solid var(--line); }
.ref article { display: grid; grid-template-columns: 34px 1fr; gap: 14px; padding-block: 18px; border-bottom: 1px solid var(--line); }
.ref article > div { display: flex; flex-direction: column; gap: 8px; min-width: 0; }
.ref .hd { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 12px; }
.ref .range { font-family: var(--mono); font-size: 0.82rem; color: var(--red); }
.ref ul { margin: 0; padding-left: 18px; display: flex; flex-direction: column; gap: 4px; max-width: 66ch; }
.ref ul li::marker { color: var(--muted); }

table { border-collapse: collapse; width: 100%; font-size: 0.95rem; }
.tablewrap { overflow-x: auto; }
th, td { text-align: left; vertical-align: top; padding: 8px 12px 8px 0; border-bottom: 1px solid var(--line); }
th { font-family: var(--mono); font-size: 0.78rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted); font-weight: 600; }
td:first-child { white-space: nowrap; font-weight: 600; }
td.mono { font-family: var(--mono); font-size: 0.88rem; font-variant-numeric: tabular-nums; }

.patches { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 14px; }
.patch { background: var(--panel); border: 1px solid var(--line); padding: 16px; display: flex; flex-direction: column; gap: 8px; min-width: 0; }
.patch ol { margin: 0; padding-left: 20px; display: flex; flex-direction: column; gap: 4px; }
.patch .why { color: var(--muted); font-size: 0.92rem; }

footer { border-top: 1px solid var(--line); padding-top: 20px; color: var(--muted); font-size: 0.92rem; display: flex; flex-direction: column; gap: 8px; }
:focus-visible { outline: 2px solid var(--red); outline-offset: 2px; }

/* Site breadcrumb above the sheet */
.sitenav { max-width: 1040px; margin: 0 auto; font-family: var(--mono); font-size: 11.5px; letter-spacing: 0.03em; padding-block: 14px; }
.sitenav a { color: var(--muted); text-decoration: none; }
.sitenav a:hover { color: var(--ink); }
.sitenav span { color: var(--line); padding: 0 6px; }
.sitenav-band { border-bottom: 1px solid var(--line); }
</style>

    <div class="sitenav-band">
      <nav class="sitenav" aria-label="Site">
        <a href="/">Max Hodges</a><span>/</span><a href="/blog">Projects</a>
      </nav>
    </div>

<main>
  <!-- ============ OVERVIEW ============ -->
  <header id="overview">
    <div class="maker"><b>Nippon Industrial Noise</b><span>Building New Futures</span></div>
    <div class="hero">
      <div class="hero-text">
    <div class="title">
      <div class="kanji" lang="ja" aria-hidden="true">震度<small>ヴェルシオ</small></div>
      <h1>Shindo Versio</h1>
      <div class="tagline">Seismic Rumble &amp; Texture Generator</div>
    </div>
    <p class="lede">Bottomless rumble and texture generator for industrial techno, built on the kick itself.</p>
    <p>When rack space is tight and time is short, one knob per job gets you there fast: rolling rumble, tight punchy thump, shimmering metallic haze, dry industrial hiss, or anything in between. It ducks on every kick, the sidechain is built in. Three reverb engines, three saturation types, seven CV inputs. Shindo turns one kick into a whole low end. Pairs well with clean 909s, 808s and distorted bass drums alike. If it kicks, it rumbles.</p>
    <div class="eyebrow">Eurorack firmware · Noise Engineering Versio · 10 HP</div>
