          <circle class="mix" cx="470" cy="-5" r="10"/><path class="w" d="M463 -5 H477 M470 -12 V2"/><text x="490" y="0">MIXER</text>
          <circle class="dot" cx="580" cy="-5" r="4"/><text x="594" y="0">SPLIT</text>
          <g transform="translate(680 0)"><circle class="dot" cx="0" cy="-12" r="3"/><circle class="dot" cx="0" cy="4" r="3"/><line class="w" x1="24" y1="-4" x2="2" y2="3"/><circle class="dot" cx="24" cy="-4" r="3"/><text x="38" y="0">SWITCH</text></g>
