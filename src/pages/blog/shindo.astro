      <div class="legend"><span class="lk">kick</span><span class="lr">rumble, Out 1</span><span class="lt">texture, Out 2</span><span class="ld">duck (Out 1 volume)</span></div>
    </div>
    <h3>One envelope, three stages</h3>
    <ul class="features">
      <li><b>Attack: 2 ms</b><span>A smooth S-curve down. It hides under the kick's own transient, so it never clicks.</span></li>
      <li><b>Hold: the gate's length</b><span>The rumble stays down while the gate is high, with no minimum: a 1 ms trigger gets just the attack, then the release. The Hold knob stretches or shortens it, 0.25× to 4×. With no gate, the Hold knob sets it, 5–400 ms.</span></li>
      <li><b>Release: a mild swell</b><span>Rises evenly in loudness from the ducked level back to full, so the swell is audible all the way up instead of popping back.</span></li>
    </ul>
    <h3>Two ways to trigger it</h3>
    <div class="tablewrap"><table>
      <thead><tr><th>Mode</th><th>How it fires</th><th>Best for</th></tr></thead>
      <tbody>
        <tr><td>Gate</td><td>Each rising edge on the Gate input, or the Tap button. Gate length × the Hold knob sets the hold, and Release is a share of it.</td><td>Sequenced ducks: per-step lengths, off-beat ducks, ghost ducks without a kick.</td></tr>
        <tr><td>Detect</td><td>Automatic: no gate for 4 seconds, and Shindo Versio listens for hits in the kick itself. The Hold knob sets the hold.</td><td>Patch-and-play: one cable, the duck follows whatever kick you send.</td></tr>
      </tbody>
    </table></div>
    <p class="note">The trigger source changes only the timing, never the shape, so a patch sounds the same with or without a gate.</p>
  </section>

  <!-- ============ PATCH IDEAS ============ -->
  <section id="patches" aria-labelledby="patches-h">
    <h2 id="patches-h">Patch ideas</h2>
    <div class="patches">
      <div class="patch"><h3>First rumble</h3><ol><li>Kick through a stackcable: one end to your mixer, the other into the Kick Input. Out 1 to the mixer too, turned down to start.</li><li>Engine on Sub, Split at noon, Smear at noon.</li><li>Hold at noon, Release around 300 ms.</li><li>Predelay up until the swell lands between kicks.</li></ol><span class="why">The classic dark rumble: one cable in, the duck detected from the kick.</span></div>
      <div class="patch"><h3>Sequenced duck</h3><ol><li>Patch your sequencer's gate into Gate.</li><li>Vary gate lengths per step: short for a quick dip, long for a gated chop.</li><li>Set Release to around 25% of the gate.</li></ol><span class="why">Every step gets its own duck shape, and the swell scales with each gate.</span></div>
      <div class="patch"><h3>Rolling triplets</h3><ol><li>Predelay to a dotted eighth (about 346 ms at 130 BPM).</li><li>Feedback around 50%.</li><li>Engine on Texture, Out 2 to the mixer alongside Out 1.</li></ol><span class="why">The repeats fall 3 against 4 and drift across the bar, lining up again every 3 bars.</span></div>
      <div class="patch"><h3>Noise bed</h3><ol><li>Noise into Mix In: slow sample-and-hold for grit, white noise for air.</li><li>Set the noise level at the source, or through a VCA to modulate it.</li></ol><span class="why">The noise pumps with the rumble but stays clean, adding texture on top of the smear.</span></div>
      <div class="patch"><h3>Breathing drive</h3><ol><li>A slow LFO into the Drive CV, Drive knob around 2 o'clock.</li><li>Drive type on Tube or Tape.</li></ol><span class="why">The LFO sweeps from grit on top into a fully driven sub and back.</span></div>
      <div class="patch"><h3>Breakdown</h3><ol><li>Smear near full, Feedback around 60%.</li><li>Stop the kick.</li></ol><span class="why">The rumble rings out as a drone for a few seconds, then fades by itself.</span></div>
    </div>
  </section>

  <!-- ============ SPECS ============ -->
  <section id="specs" aria-labelledby="specs-h">
    <h2 id="specs-h">Specs</h2>
    <div class="tablewrap"><table>
      <tbody>
        <tr><td>Format</td><td>Eurorack, 10 HP</td></tr>
        <tr><td>Platform</td><td>Noise Engineering Versio (Electro-Smith Daisy Seed). Shindo Versio is alternate firmware: install it on a Versio module.</td></tr>
        <tr><td>Audio</td><td class="mono">48 kHz</td></tr>
        <tr><td>Inputs</td><td>Kick Input, Mix In (normalled to the Kick Input), Gate, 7 × CV</td></tr>
        <tr><td>Outputs</td><td>Out 1 (rumble, below the split), Out 2 (texture, above it). Both hot.</td></tr>
        <tr><td>Controls</td><td>7 knobs, 2 three-way switches, 1 button, 4 RGB lights</td></tr>
        <tr><td>Depth, power</td><td>As the Versio hardware. <span class="todo">To confirm</span></td></tr>
        <tr><td>Install</td><td>Flashed over USB, as other Versio firmware. <span class="todo">Instructions coming</span></td></tr>
      </tbody>
    </table></div>
  </section>

  <footer>
    <p><b>Status:</b> proof of concept. The sound engine runs on a computer, with a web sandbox for tuning settings by ear. It hasn't been put on the module yet, so details on this page can still change.</p>
    <p><b>Credits:</b> the Mutable engine is the reverb from Mutable Instruments' Rings by Émilie Gillet, used under the MIT license. Versio is a platform by Noise Engineering; Shindo Versio is independent firmware by Nippon Industrial Noise, not made by them.</p>
  </footer>
</main>

<script is:inline>
(function () {
  const ns = 'http://www.w3.org/2000/svg';
  function add(parent, tag, attrs, text) {
    const e = document.createElementNS(ns, tag);
    for (const k in attrs) e.setAttribute(k, attrs[k]);
    if (text != null) e.textContent = text;
    parent.appendChild(e); return e;
  }

  // The duck, one beat, drawn like the sandbox's Beat view from a real render of the engine
  // (#beat-data: RK_IT8_Kick_16, a kick whose attack stands above its body, at 130 BPM, Dark
  // FDN 2, Split 1.1 kHz, quarter-note gates at 1+ (123 ms), Hold ×0.82, Release 105% of the
  // hold: a 98 ms hold and a 104 ms release). Per pixel min/max of each channel, each scaled to its own peak; the duck's
  // gain; the hold and release spans in ms.
  const svg = document.getElementById('scope'), B = JSON.parse(document.getElementById('beat-data').textContent);
  const W = 720, H = 220, ruler = 18, top = 8, area = H - ruler - top - 4, mid = top + area / 2;
  const xMs = ms => ms / B.ms * W;
  const defs = add(svg, 'defs', {});
  const shade = (from, to, color, op) =>
    add(svg, 'rect', { x: xMs(from), y: top, width: xMs(to) - xMs(from), height: area, fill: color, 'fill-opacity': op });
  shade(B.hold[0], B.hold[1], 'var(--scope-hold)', 0.16);
  shade(B.release[0], B.release[1], 'var(--scope-release)', 0.12);
  // A channel as a filled outline, the fill fading towards the centre line.
  const outline = (name, color, alpha) => {
    const g = add(defs, 'linearGradient', { id: 'g-' + name, x1: 0, y1: 0, x2: 0, y2: 1 });
    add(g, 'stop', { offset: 0, 'stop-color': color });
    add(g, 'stop', { offset: 0.5, 'stop-color': color, 'stop-opacity': 0.33 });
    add(g, 'stop', { offset: 1, 'stop-color': color });
    const [hi, lo] = B[name];
    let d = '';
    for (let x = 0; x < W; x++) d += (x ? 'L' : 'M') + x + ' ' + (mid - hi[x] * area / 2).toFixed(1);
    for (let x = W - 1; x >= 0; x--) d += 'L' + x + ' ' + (mid - lo[x] * area / 2).toFixed(1);
    add(svg, 'path', { d: d + 'Z', fill: `url(#g-${name})`, 'fill-opacity': alpha, stroke: color,
                       'stroke-opacity': Math.min(1, alpha + 0.3), 'stroke-width': 1 });
  };
  outline('kick', 'var(--scope-kick)', 0.55);
  outline('rumble', 'var(--scope-rumble)', 0.45);
  outline('texture', 'var(--scope-texture)', 0.4);
  let d = '';
  B.gain.forEach((v, x) => { d += (x ? 'L' : 'M') + x + ' ' + (top + (1 - v) * area).toFixed(1); });
  add(svg, 'path', { d, fill: 'none', stroke: 'var(--scope-ink)', 'stroke-width': 1.5 });
  // hold and release labels, on top of the waveforms
  const label = (x, y, text) => add(svg, 'text', { x, y, class: 'tag', 'paint-order': 'stroke' }, text);
  label(xMs(B.hold[0]) + 6, top + 16, `hold ${Math.round(B.hold[1] - B.hold[0])} ms`);
  label(xMs(B.release[0]) + 6, top + 34, `release ${Math.round(B.release[1] - B.release[0])} ms`);
  // millisecond ruler
  for (let ms = 0; ms <= B.ms; ms += 10) {
    const x = xMs(ms) + 0.5, major = ms % 100 === 0;
    add(svg, 'line', { x1: x, x2: x, y1: H - ruler, y2: H - ruler + (major ? 7 : 3), stroke: 'var(--scope-line)' });
    if (major && ms > 0) add(svg, 'text', { x: x + 3, y: H - 3 }, `${ms} ms`);
  }

  // Panel callouts: [number, side, callout y, target x, target y, target radius, elbow]
  const co = document.getElementById('callouts');
  const L = -17, R = 67.5;
  [
    [1, L, 18.5, 7.77, 18.53, 5.4], [3, L, 30, 25.17, 28.69, 5.4], [2, L, 39.5, 7.77, 39.49, 5.4],
    [4, L, 49.3, 25.17, 49.33, 5.4], [8, L, 57.9, 6.9, 57.9, 0], [9, L, 67.4, 6.9, 67.4, 0],
    [12, L, 88, 5.23, 83.3, 3.3], [14, L, 108, 5.23, 111.24, 3.3], [15, L, 121.5, 18.57, 111.24, 3.3, true],
    [5, R, 18.5, 43.33, 18.53, 5.4], [11, R, 28, 34.44, 19.8, 1.4, true], [6, R, 39.5, 43.33, 39.49, 5.4],
    [7, R, 60.4, 43.33, 60.44, 5.4], [10, R, 71, 26.18, 69.33, 2.8],
    [13, R, 97.3, 44.6, 97.27, 3.3], [16, R, 105.5, 31.9, 111.24, 3.3, true], [17, R, 119, 44.6, 111.24, 3.3],
  ].forEach(([n, x, y, tx, ty, tr, elbow]) => {
    const r = 3.2, dir = Math.sign(tx - x), sx = x + dir * r;
    let ex, ey;
    if (elbow) {
      ex = tx; ey = ty + Math.sign(y - ty) * tr;
      add(co, 'polyline', { points: `${sx},${y} ${tx},${y} ${ex},${ey}`, fill: 'none' });
    } else {
      const dx = tx - sx, dy = ty - y, len = Math.hypot(dx, dy);
      ex = tx - dx / len * tr; ey = ty - dy / len * tr;
      add(co, 'line', { x1: sx, y1: y, x2: ex, y2: ey });
    }
    add(co, 'circle', { class: 'dot', cx: ex, cy: ey, r: 0.55 });
    add(co, 'circle', { cx: x, cy: y, r });
    add(co, 'text', { x, y: y + 1.2, 'text-anchor': 'middle' }, n);
  });
})();
</script>
