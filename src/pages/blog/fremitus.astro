---
// Interactive blog article: concept page for the Fremitus Versio firmware.
// Deliberately standalone (no SiteLayout/Tailwind) to keep the piece's
// own art direction; fonts are self-hosted like the rest of the site.
import "@fontsource-variable/bricolage-grotesque/opsz.css";
import "@fontsource/ibm-plex-sans/400.css";
import "@fontsource/ibm-plex-sans/500.css";
import "@fontsource/ibm-plex-sans/600.css";
import "@fontsource/ibm-plex-mono/500.css";
import "@fontsource/ibm-plex-mono/600.css";
import { getImage } from "astro:assets";
import heroSrc from "../../assets/images/blog/fremitus.jpg";

const title = "Fremitus Versio — Max Hodges";
const description =
  "Concept firmware for the Noise Engineering Versio: plug in a kick, get a techno rumble out — predelay, smear, drive, filter, and sidechain duck in one module, one knob per job.";
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(
  (await getImage({ src: heroSrc, width: 1200, format: "jpeg" })).src,
  Astro.site,
).href;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="article" />
    <meta property="og:site_name" content="Max Hodges" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body>
    <style is:global>
      /* Layout: a single reading column like a module manual (dark only); hero, the duck, signal flow, then the panel with numbered callouts and its key. */
      :root {
        --bg: #141219;
        --panel: #1d1a24;
        --ink: #efecf4;
        --muted: #a49db0;
        --line: #322d3c;
        --rumble: #ff4fa8;
        --kick: #3ee07f;
        --duck: #efecf4;
        --display: "Bricolage Grotesque Variable", "Arial Narrow", system-ui, sans-serif;
        --body: "IBM Plex Sans", system-ui, -apple-system, "Segoe UI", sans-serif;
        --mono: "IBM Plex Mono", ui-monospace, Menlo, Consolas, monospace;
        color-scheme: dark;
      }
      * { box-sizing: border-box; }
      html, body { margin: 0; padding: 0; }
      body {
        background: var(--bg); color: var(--ink); font-family: var(--body); font-size: 16px; line-height: 1.6;
        padding-left: max(16px, env(safe-area-inset-left, 0px));
        padding-right: max(16px, env(safe-area-inset-right, 0px));
      }
      img { max-width: 100%; }
      main { max-width: 760px; margin: 0 auto; padding-block: 24px 72px; display: flex; flex-direction: column; gap: 56px; }
      h1, h2, h3 { font-family: var(--display); text-wrap: balance; margin: 0; line-height: 1.05; }
      h1 { font-size: clamp(2.6rem, 8vw, 4.4rem); font-weight: 800; letter-spacing: -0.02em; }
      h2 { font-size: 1.6rem; font-weight: 800; }
      h3 { font-size: 0.8rem; font-family: var(--mono); font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); }
      p { margin: 0; max-width: 65ch; }
      .eyebrow { font-family: var(--mono); font-size: 0.78rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); }
      section, header { display: flex; flex-direction: column; gap: 16px; }
      .lede { font-size: 1.15rem; }
      .lede b { color: var(--rumble); }
      .k { color: var(--kick); font-weight: 600; }

      .sitenav { max-width: 760px; margin: 0 auto; font-family: var(--mono); font-size: 11.5px; letter-spacing: 0.03em; padding-block: 14px; }
      .sitenav a { color: var(--muted); text-decoration: none; }
      .sitenav a:hover { color: var(--ink); }
      .sitenav span { color: var(--line); padding: 0 6px; }
      .sitenav-band { border-bottom: 1px solid var(--line); }

      .scope { background: var(--panel); border: 1px solid var(--line); border-radius: 10px; padding: 16px; display: flex; flex-direction: column; gap: 10px; }
      .scope svg { width: 100%; height: auto; display: block; }
      .legend { display: flex; flex-wrap: wrap; gap: 6px 18px; font-size: 0.85rem; color: var(--muted); }
      .legend span::before { content: ""; display: inline-block; width: 12px; height: 3px; vertical-align: middle; margin-right: 6px; background: currentColor; }
      .legend .lk { color: var(--kick); } .legend .lr { color: var(--rumble); } .legend .ld { color: var(--duck); }

      .flow { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; font-family: var(--mono); font-size: 0.85rem; }
      .flow span { border: 1px solid var(--line); background: var(--panel); border-radius: 6px; padding: 4px 10px; }
      .flow span.in { border-color: var(--kick); color: var(--kick); }
      .flow span.out { border-color: var(--rumble); color: var(--rumble); }
      .flow i { font-style: normal; color: var(--muted); }

      .panel-fig { margin: 0; display: flex; justify-content: center; }
      .panel-fig svg { width: min(520px, 100%); height: auto; display: block; }
      .pt { font-family: var(--mono); fill: #f3eef8; }
      .pt.title { font-family: var(--display); font-weight: 800; font-size: 4.6px; letter-spacing: 0.08em; }
      .pt.lbl { font-size: 1.85px; letter-spacing: 0.04em; }
      .pt.tiny { font-size: 1.45px; fill: #8e8898; }
      .co circle { fill: var(--rumble); }
      .co text { font-family: var(--display); font-weight: 800; font-size: 3.4px; fill: #141219; }
      .co line, .co polyline { stroke: var(--rumble); stroke-width: 0.35; }
      .co .dot { fill: var(--rumble); }

      .key { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 28px 32px; }
      .key > div { display: flex; flex-direction: column; gap: 12px; min-width: 0; }
      .key ol { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 12px; }
      .key li { display: grid; grid-template-columns: 28px 1fr; gap: 12px; align-items: start; }
      .num { width: 26px; height: 26px; border-radius: 50%; background: var(--rumble); color: var(--bg); font-family: var(--display); font-weight: 800; font-size: 0.85rem; display: grid; place-items: center; font-variant-numeric: tabular-nums; }
      .key b { display: block; font-weight: 600; }
      .key span.d { color: var(--muted); font-size: 0.93rem; }
      .note { color: var(--muted); font-size: 0.93rem; }

      .status { border-top: 1px solid var(--line); padding-top: 20px; color: var(--muted); font-size: 0.95rem; }
    </style>

    <div class="sitenav-band">
      <nav class="sitenav" aria-label="Site">
        <a href="/">Max Hodges</a><span>/</span><a href="/blog">Projects</a>
      </nav>
    </div>

    <main>
      <header>
        <div class="eyebrow">Eurorack firmware · Noise Engineering Versio</div>
        <h1>Fremitus Versio</h1>
        <p class="lede">Plug in a <span class="k">kick</span>, get a <b>techno rumble</b> out: the dark, rolling low end under the kick that often works as the bassline.</p>
        <p>Normally you'd build this in a DAW from a chain of plugins: a reverb to smear the kick, saturation, a filter, and a sidechain compressor to duck it out of the kick's way. Fremitus does the whole chain in one module, with one knob per job. <i>Fremitus</i> is Latin for a low roar.</p>
      </header>

      <section aria-labelledby="duck-h">
        <h2 id="duck-h">The trick: ducking</h2>
        <p>The kick and the rumble live in the same low frequencies, so they take turns. On every kick the rumble drops out, then swells back in before the next one. That push and pull is what makes a rumble groove.</p>
        <div class="scope">
          <svg id="scope" viewBox="0 0 720 200" role="img" aria-label="One bar: four kicks, with the rumble ducking on each kick and swelling back between them"></svg>
          <div class="legend"><span class="lk">kick</span><span class="lr">rumble</span><span class="ld">duck (rumble volume)</span></div>
        </div>
      </section>

      <section aria-labelledby="flow-h">
        <h2 id="flow-h">What happens inside</h2>
        <div class="flow" aria-label="Signal flow">
          <span class="in">kick in</span><i>→</i><span>predelay</span><i>→</i><span>smear</span><i>→</i><span>drive</span><i>→</i><span>color</span><i>→</i><span>+ In 2</span><i>→</i><span>duck</span><i>→</i><span class="out">rumble out</span>
        </div>
        <p>The kick is delayed a little, smeared into a cloud, saturated, filtered, and finally ducked. The low sub stays clean through the drive, so the bottom end stays solid however dirty you push it.</p>
      </section>

      <section aria-labelledby="panel-h">
        <h2 id="panel-h">The panel</h2>
        <figure class="panel-fig">
          <svg id="panel" viewBox="-24 -1 98.5 130.5" role="img" aria-label="Mock-up of the Fremitus panel with numbered callouts 1 to 17, explained in the key below">
            <defs>
              <g id="cap"><circle r="5.2" fill="#2a2433" stroke="#0d0b10" stroke-width="0.4"></circle><circle r="4.2" fill="#3a3345"></circle><line x1="0" y1="-1.2" x2="0" y2="-4" stroke="#f3eef8" stroke-width="0.6" stroke-linecap="round"></line></g>
              <g id="jack"><circle r="3.1" fill="#bdb8c6" stroke="#8e8898" stroke-width="0.3"></circle><circle r="1.8" fill="#0d0b10"></circle></g>
            </defs>
            <rect x="0" y="0" width="50.5" height="128.5" rx="0.8" fill="#221d2a" stroke="#3a3345" stroke-width="0.4"></rect>
            <g fill="#3a3345"><circle cx="7.65" cy="3" r="1.6"></circle><circle cx="43.21" cy="3" r="1.6"></circle><circle cx="7.65" cy="125.5" r="1.6"></circle><circle cx="43.21" cy="125.5" r="1.6"></circle></g>
            <text x="25.25" y="10.6" text-anchor="middle" class="pt title">FREMITUS</text>
            <g><circle cx="17.3" cy="19.8" r="1.2" fill="#ff4fa8"></circle><circle cx="22.38" cy="19.8" r="1.2" fill="#3ee07f"></circle><circle cx="29.36" cy="19.8" r="1.2" fill="#4a4256"></circle><circle cx="34.44" cy="19.8" r="1.2" fill="#4a4256"></circle></g>
            <!-- knobs: hole positions from the Versio drill template -->
            <use href="#cap" x="7.77" y="18.53"></use><use href="#cap" x="43.33" y="18.53"></use><use href="#cap" x="25.17" y="28.69"></use>
            <use href="#cap" x="7.77" y="39.49"></use><use href="#cap" x="43.33" y="39.49"></use><use href="#cap" x="25.17" y="49.33"></use>
            <use href="#cap" x="43.33" y="60.44"></use>
            <g class="pt lbl" text-anchor="middle">
              <text x="7.77" y="26.1">PREDELAY</text><text x="43.33" y="26.1">SMEAR</text><text x="25.17" y="36.3">COLOR</text>
              <text x="7.77" y="47.1">DRIVE</text><text x="43.33" y="47.1">DEPTH</text><text x="25.17" y="56.9">RELEASE</text>
              <text x="43.33" y="68">FEEDBACK</text>
            </g>
            <g class="pt tiny" text-anchor="middle"><text x="25.17" y="38.6">dark · bright</text><text x="43.33" y="49.4">duck</text><text x="25.17" y="59.2">duck</text></g>
            <g><rect x="6.9" y="55.6" width="3" height="4.6" rx="0.6" fill="#bdb8c6"></rect><circle cx="8.4" cy="56.8" r="1.1" fill="#f3eef8"></circle>
               <rect x="6.9" y="65.1" width="3" height="4.6" rx="0.6" fill="#bdb8c6"></rect><circle cx="8.4" cy="66.3" r="1.1" fill="#f3eef8"></circle></g>
            <g class="pt tiny"><text x="11.4" y="56.3">MUT</text><text x="11.4" y="58.4">FDN</text><text x="11.4" y="60.5">GRAIN</text>
              <text x="11.4" y="65.8">TUBE</text><text x="11.4" y="67.9">TAPE</text><text x="11.4" y="70">FOLD</text></g>
            <text x="8.4" y="53.6" text-anchor="middle" class="pt lbl">ENGINE</text>
            <text x="8.4" y="73.4" text-anchor="middle" class="pt lbl">DRIVE TYPE</text>
            <circle cx="26.18" cy="69.33" r="2.6" fill="#ff4fa8" stroke="#0d0b10" stroke-width="0.3"></circle>
            <text x="26.18" y="74.6" text-anchor="middle" class="pt lbl">TAP</text>
            <g>
              <use href="#jack" x="5.23" y="83.3"></use><use href="#jack" x="18.57" y="83.3"></use><use href="#jack" x="31.9" y="83.3"></use><use href="#jack" x="44.6" y="83.3"></use>
              <use href="#jack" x="5.23" y="97.27"></use><use href="#jack" x="18.57" y="97.27"></use><use href="#jack" x="31.9" y="97.27"></use><use href="#jack" x="44.6" y="97.27"></use>
              <use href="#jack" x="5.23" y="111.24"></use><use href="#jack" x="18.57" y="111.24"></use><use href="#jack" x="31.9" y="111.24"></use><use href="#jack" x="44.6" y="111.24"></use>
            </g>
            <g class="pt lbl" text-anchor="middle">
              <text x="5.23" y="89">PRE</text><text x="18.57" y="89">SMEAR</text><text x="31.9" y="89">COLOR</text><text x="44.6" y="89">DRIVE</text>
              <text x="5.23" y="103">DEPTH</text><text x="18.57" y="103">REL</text><text x="31.9" y="103">FDBK</text><text x="44.6" y="103" fill="#3ee07f">GATE</text>
              <text x="5.23" y="117" fill="#3ee07f">KICK</text><text x="18.57" y="117">IN 2</text><text x="31.9" y="117" fill="#ff4fa8">RUMBLE</text><text x="44.6" y="117" fill="#ff4fa8">KICK</text>
            </g>
            <g class="pt tiny" text-anchor="middle"><text x="5.23" y="119.2">in 1</text><text x="31.9" y="119.2">out 1</text><text x="44.6" y="119.2">out 2</text></g>
            <g id="callouts" class="co"></g>
          </svg>
        </figure>

        <div class="key">
          <div>
            <h3>Knobs</h3>
            <ol>
              <li><span class="num">1</span><div><b>Predelay</b><span class="d">Pushes the rumble later after the kick, up to 666 ms.</span></div></li>
              <li><span class="num">2</span><div><b>Smear</b><span class="d">How big and long the cloud is.</span></div></li>
              <li><span class="num">3</span><div><b>Color</b><span class="d">A DJ-style filter. Left is dark sub, middle is open, right is thin and textured.</span></div></li>
              <li><span class="num">4</span><div><b>Drive</b><span class="d">Saturation on everything above the sub.</span></div></li>
              <li><span class="num">5</span><div><b>Duck depth</b><span class="d">How far the rumble drops on each kick.</span></div></li>
              <li><span class="num">6</span><div><b>Duck release</b><span class="d">How fast it swells back.</span></div></li>
              <li><span class="num">7</span><div><b>Feedback</b><span class="d">Repeats the predelay, turning one swell into a rolling rumble. It always dies away on its own.</span></div></li>
            </ol>
          </div>
          <div>
            <h3>Switches, button, lights</h3>
            <ol>
              <li><span class="num">8</span><div><b>Smear engine</b><span class="d">Mutable (smooth reverb from Mutable Instruments' Rings), Dark FDN (dark reverb, tight to huge) or Granular (a cloud of tiny grains).</span></div></li>
              <li><span class="num">9</span><div><b>Drive type</b><span class="d">Tube (warm), Tape (soft, rounded) or Wavefolder (aggressive growl).</span></div></li>
              <li><span class="num">10</span><div><b>Tap</b><span class="d">Fires the duck by hand.</span></div></li>
              <li><span class="num">11</span><div><b>Lights</b><span class="d">Show the duck, and whether the gate or the kick is firing it.</span></div></li>
            </ol>
            <h3>Jacks</h3>
            <ol>
              <li><span class="num">12</span><div><b>CV inputs</b><span class="d">One per knob, so a sequencer can move depth, release or drive per step.</span></div></li>
              <li><span class="num">13</span><div><b>Gate</b><span class="d">Fires the duck. Gate length is how long the rumble stays down. No gate patched? It ducks on each kick it hears.</span></div></li>
              <li><span class="num">14</span><div><b>Kick in</b><span class="d">Your kick.</span></div></li>
              <li><span class="num">15</span><div><b>In 2</b><span class="d">Optional noise or texture, ducked with the rumble but not smeared or filtered.</span></div></li>
              <li><span class="num">16</span><div><b>Rumble out</b><span class="d">The rumble.</span></div></li>
              <li><span class="num">17</span><div><b>Kick out</b><span class="d">The clean kick, kept in time with the rumble.</span></div></li>
            </ol>
          </div>
        </div>
        <p class="note">A mock-up on the Versio's real hole layout. Which jack and knob land where is still to be settled in the firmware.</p>
      </section>

      <p class="status"><b>Status:</b> proof of concept. The sound engine runs on a computer, with a web sandbox for tuning settings by ear. It hasn't been put on the module yet.</p>
    </main>

    <script is:inline>
      (function () {
        const ns = 'http://www.w3.org/2000/svg';
        function add(parent, tag, attrs, text) {
          const e = document.createElementNS(ns, tag);
          for (const k in attrs) e.setAttribute(k, attrs[k]);
          if (text != null) e.textContent = text;
          parent.appendChild(e); return e;
        }

        // The duck, one bar
        const svg = document.getElementById('scope'), W = 720, H = 200, mid = 100, beat = W / 4;
        function duck(x) {           // rumble volume 0..1 within a beat: duck, short hold, S-curve release
          const t = (x % beat) / beat;
          if (t < 0.12) return 0.12;
          if (t < 0.72) { const p = (t - 0.12) / 0.6; return 0.12 + 0.88 * (0.5 - 0.5 * Math.cos(Math.PI * p)); }
          return 1;
        }
        function wave(amp, freq, phase) {
          let top = '', bot = '';
          for (let x = 0; x <= W; x += 2) {
            const a = amp(x) * (0.75 + 0.25 * Math.sin(x * freq + phase));
            top += (x ? 'L' : 'M') + x + ' ' + (mid - a * 80).toFixed(1);
            bot = 'L' + x + ' ' + (mid + a * 80).toFixed(1) + bot;
          }
          return top + bot + 'Z';
        }
        add(svg, 'path', { d: wave(x => 0.6 * duck(x), 0.11, 0), fill: 'var(--rumble)', 'fill-opacity': '0.35', stroke: 'var(--rumble)', 'stroke-width': '1' });
        // kick: a real waveform, full height, pitch dropping as it decays
        let kd = '';
        for (let x = 0; x <= W; x += 0.5) {
          const t = (x % beat) / beat, s = t * 0.46;               // seconds into the beat at 130 BPM
          const env = Math.exp(-s / 0.07), phase = 2 * Math.PI * (48 * s + 1.2 * (1 - Math.exp(-s / 0.012)));
          kd += (x ? 'L' : 'M') + x + ' ' + (mid - 92 * env * Math.sin(phase * 4)).toFixed(1);
        }
        add(svg, 'path', { d: kd, fill: 'none', stroke: 'var(--kick)', 'stroke-width': '2', 'stroke-linejoin': 'round' });
        let d = '';
        for (let x = 0; x <= W; x += 2) d += (x ? 'L' : 'M') + x + ' ' + (190 - duck(x) * 180).toFixed(1);
        add(svg, 'path', { d, fill: 'none', stroke: 'var(--duck)', 'stroke-width': '2' });
        for (let i = 1; i < 4; i++) add(svg, 'line', { x1: i * beat, x2: i * beat, y1: 0, y2: H, stroke: 'var(--line)', 'stroke-dasharray': '3 4' });

        // Panel callouts: [number, side, callout y, target x, target y, target radius, elbow]
        // elbow: run level to the target's x, then straight up or down, to stay clear of other parts.
        const co = document.getElementById('callouts');
        const L = -17, R = 67.5;
        [
          [1, L, 18.5, 7.77, 18.53, 5.4], [3, L, 30, 25.17, 28.69, 5.4], [4, L, 39.5, 7.77, 39.49, 5.4],
          [6, L, 49.3, 25.17, 49.33, 5.4], [8, L, 57.9, 6.9, 57.9, 0], [9, L, 67.4, 6.9, 67.4, 0],
          [12, L, 88, 5.23, 83.3, 3.3], [14, L, 108, 5.23, 111.24, 3.3], [15, L, 121.5, 18.57, 111.24, 3.3, true],
          [2, R, 18.5, 43.33, 18.53, 5.4], [11, R, 28, 34.44, 19.8, 1.4, true], [5, R, 39.5, 43.33, 39.49, 5.4],
          [7, R, 60.4, 43.33, 60.44, 5.4], [10, R, 71, 26.18, 69.33, 2.8],
          [13, R, 97.3, 44.6, 97.27, 3.3], [16, R, 105.5, 31.9, 111.24, 3.3, true], [17, R, 119, 44.6, 111.24, 3.3],
        ].forEach(([n, x, y, tx, ty, tr, elbow]) => {
          const r = 3.2, dir = Math.sign(tx - x), sx = x + dir * r;
          let ex, ey;
          if (elbow) {
            ex = tx; ey = ty + Math.sign(y - ty) * tr;
            add(co, 'polyline', { points: `${sx},${y} ${tx},${y} ${ex},${ey}`, fill: 'none' });
          } else {
            const dx = tx - sx, dy = ty - y, len = Math.hypot(dx, dy);
            ex = tx - dx / len * tr; ey = ty - dy / len * tr;
            add(co, 'line', { x1: sx, y1: y, x2: ex, y2: ey });
          }
          add(co, 'circle', { class: 'dot', cx: ex, cy: ey, r: 0.55 });
          add(co, 'circle', { cx: x, cy: y, r });
          add(co, 'text', { x, y: y + 1.2, 'text-anchor': 'middle' }, n);
        });
      })();
    </script>
  </body>
</html>
