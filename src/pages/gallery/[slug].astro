---
import { getCollection } from "astro:content";
import { getImage } from "astro:assets";
import SiteLayout from "../../layouts/SiteLayout.astro";
import GallerySlider from "../../components/GallerySlider.svelte";
import { buildGalleryImages } from "../../lib/gallery-images";

export async function getStaticPaths() {
  const galleries = await getCollection("galleries");
  return galleries
    .filter((gallery) => gallery.data.visible !== false)
    .map((gallery) => ({
      params: { slug: gallery.id },
      props: { gallery },
    }));
}

const { gallery } = Astro.props;
const images = await buildGalleryImages(gallery);
const ogImage = (
  await getImage({ src: gallery.data.coverImage, width: 1200, format: "jpeg" })
).src;
const description =
  gallery.data.description ??
  `${gallery.data.title} — a photo series by Max Hodges.`;
---

<SiteLayout
  title={`Max Hodges — ${gallery.data.title}`}
  description={description}
  ogImage={ogImage}
  fullHeight
  breadcrumbItems={[
    { label: "Galleries", href: "/" },
    { label: gallery.data.title },
  ]}
>
  <GallerySlider images={images} title={gallery.data.title} client:load />
</SiteLayout>
