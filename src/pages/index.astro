---
import { Picture, getImage } from "astro:assets";
import { getCollection } from "astro:content";
import SiteLayout from "../layouts/SiteLayout.astro";
import { galleryDateRange } from "../lib/gallery-images";

const galleries = (await getCollection("galleries"))
  .filter((gallery) => gallery.data.visible !== false)
  .sort((a, b) => a.data.order - b.data.order);

const ranges = Object.fromEntries(
  await Promise.all(
    galleries.map(async (g) => [g.id, await galleryDateRange(g)]),
  ),
);

const coverOf = (gallery) =>
  gallery.data.coverImage ?? gallery.data.images[0]?.src;

const ogImage =
  galleries.length > 0
    ? (await getImage({ src: coverOf(galleries[0]), width: 1200, format: "jpeg" })).src
    : undefined;
---

<SiteLayout
  title="Max Hodges — Photography"
  description="Photography by Max Hodges — documentary and street photography from Japan and beyond."
  ogImage={ogImage}
>
  <!-- Kṣaṇa 刹那 -->
  <section class="columns-1 gap-6 md:columns-2 xl:columns-3">
    {
      galleries.map((gallery, index) => (
        <a
          href={`/gallery/${gallery.id}`}
          class="group mb-6 block break-inside-avoid overflow-hidden rounded-2xl border border-white/10 bg-black/30 shadow-[0_20px_60px_rgba(0,0,0,0.45)] transition hover:-translate-y-1 hover:border-white/20 hover:shadow-[0_30px_70px_rgba(0,0,0,0.6)]"
        >
          <div class="overflow-hidden">
            <Picture
              src={coverOf(gallery)}
              alt={`Cover image for ${gallery.data.title}`}
              widths={[480, 960, 1440]}
              formats={["webp", "jpeg"]}
              sizes="(max-width: 768px) 92vw, (max-width: 1280px) 45vw, 30vw"
              pictureAttributes={{ class: "block w-full" }}
              class="h-auto w-full object-cover transition duration-500 group-hover:scale-[1.02]"
              loading={index < 2 ? "eager" : "lazy"}
              fetchpriority={index === 0 ? "high" : undefined}
            />
          </div>
          <div class="flex items-baseline justify-between gap-4 bg-[#141210] px-6 py-5">
            <div class="font-display text-xl font-medium text-[color:var(--ink)]">
              {gallery.data.title}
            </div>
            {ranges[gallery.id] && (
              <div class="shrink-0 font-mono text-[0.7rem] tracking-[0.03em] text-[color:var(--muted)]">
                {ranges[gallery.id]}
              </div>
            )}
          </div>
        </a>
      ))
    }
  </section>
</SiteLayout>
